# ========================================================
# The Memorable Trip — Frontend Environment Variables
# ========================================================

# Base URL for backend API (leave empty if using Vite dev proxy in local development)
# For production on Vercel, set to your Render backend domain:
# VITE_API_BASE_URL=https://the-memorable-trip-api.onrender.com
VITE_API_BASE_URL=

# Business WhatsApp Phone Number (Digits only, including country code e.g. 91 for India)
VITE_WHATSAPP_NUMBER=919876543210
